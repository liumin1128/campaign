{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.26/MicrosoftTeams.schema.json",
    "manifestVersion": "1.26",
    "version": "1.0.0",
    "id": "3d870099-018d-43dc-8ae7-6f9ce8ec3ccc",
    "developer": {
        "name": "My Team",
        "websiteUrl": "https://example.com",
        "privacyUrl": "https://example.com/privacy",
        "termsOfUseUrl": "https://example.com/terms"
    },
    "name": {
        "short": "Campaignlocal",
        "full": "Campaign Management"
    },
    "description": {
        "short": "Campaign management tab app with multiple UI views",
        "full": "A campaign management application that shows a tab in group chats with campaign, tasks, messaging and settings views."
    },
    "icons": {
        "outline": "outline.png",
        "color": "color.png"
    },
    "accentColor": "#5B5FC7",
    "configurableTabs": [
        {
            "configurationUrl": "https://localhost:3000/tab/config",
            "canUpdateConfiguration": true,
            "scopes": [
                "team",
                "groupChat"
            ],
            "context": [
                "channelTab",
                "privateChatTab",
                "meetingChatTab",
                "meetingDetailsTab"
            ]
        }
    ],
    "staticTabs": [
        {
            "entityId": "home",
            "name": "Campaign Management",
            "contentUrl": "https://localhost:3000/tab",
            "websiteUrl": "https://localhost:3000/tab",
            "scopes": [
                "personal",
                "groupChat",
                "team"
            ]
        }
    ],
    "bots": [
        {
            "botId": "04637128-b302-42aa-b035-0d6bb4accf4f",
            "isNotificationOnly": false,
            "supportsFiles": false,
            "scopes": [
                "personal",
                "team",
                "groupChat"
            ],
            "commandLists": [
                {
                    "scopes": [
                        "personal",
                        "team",
                        "groupChat"
                    ],
                    "commands": [
                        {
                            "title": "帮助",
                            "description": "显示可用命令"
                        },
                        {
                            "title": "状态",
                            "description": "查看应用状态"
                        }
                    ]
                }
            ]
        }
    ],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "localhost:3000"
    ],
    "supportsChannelFeatures": "tier1"
}